    "panels": {
      "0": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Discord Latency"
          },
          "plugin": {
            "kind": "StatChart",
            "spec": {
              "calculation": "last-number",
              "colorMode": "value",
              "format": {
                "decimalPlaces": 0,
                "unit": "milliseconds"
              },
              "mappings": [
                {
                  "kind": "Misc",
                  "spec": {
                    "result": {
                      "value": "N/A"
                    },
                    "value": "null"
                  }
                }
              ],
              "sparkline": {},
              "thresholds": {
                "steps": [
                  {
                    "color": "#299c46",
                    "value": 0
                  },
                  {
                    "color": "rgba(237, 129, 40, 0.89)",
                    "value": 150
                  },
                  {
                    "color": "#d44a3a",
                    "value": 200
                  }
                ]
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": "${datasource}",
                    "minStep": "",
                    "query": "sum(discord_latency*1000)",
                    "seriesNameFormat": ""
                  }
                }
              }
            }
          ]
        }
      },
      "1": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Total Messages"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "yAxis": {
                "format": {
                  "unit": "decimal"
                }
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": "${datasource}",
                    "instant": false,
                    "minStep": "",
                    "query": "sum(increase(discord_messages_total{guild=~\"$guild\"}[$__range])) by (guild)",
                    "seriesNameFormat": "{{ guild }}"
                  }
                }
              }
            }
          ]
        }
      },
